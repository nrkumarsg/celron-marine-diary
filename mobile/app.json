{
  "expo": {
    "name": "Cel-Ron Marine",
    "slug": "celron-marine",
    "owner": "nrkumarsgs-team",
    "version": "1.0.0",
    "platforms": [
      "android",
      "ios"
    ],
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "celron",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#06101E"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.celron.marine",
      "entitlements": {
        "com.apple.developer.nfc.readersession.formats": [
          "NDEF",
          "TAG",
          "NDEF",
          "TAG"
        ]
      },
      "infoPlist": {
        "NFCReaderUsageDescription": "Allow Cel-Ron Marine to read and write physical NFC digital business cards.",
        "NSCameraUsageDescription": "Allow Cel-Ron Marine to capture and scan business cards with AI.",
        "NSContactsUsageDescription": "Allow Cel-Ron Marine to save scanned client cards directly to your phone contacts.",
        "UIBackgroundModes": [
          "remote-notification",
          "remote-notification"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#06101E"
      },
      "package": "com.celron.marine",
      "permissions": [
        "android.permission.NFC",
        "android.permission.CAMERA",
        "android.permission.READ_CONTACTS",
        "android.permission.WRITE_CONTACTS",
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#0A2540"
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "0c73fa71-fb4b-4d6a-a9ae-b05c63fb8da2"
      }
    }
  }
}
