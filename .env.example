# ==============================================================================
# Cel-Ron Enterprises Pte Ltd - Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env.local in /web and .env in /mobile
# 2. Fill in your project credentials from your Supabase Dashboard:
#    Go to: Project Settings -> API
# ==============================================================================

# --- SUPABASE CONFIGURATION ---
# Found at: Supabase Dashboard -> Settings -> API -> Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Found at: Supabase Dashboard -> Settings -> API -> Project API Keys -> "anon" "public"
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Supabase Service Role Key (Keep secret! Only for backend/Edge Functions/local maintenance)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- PUBLIC WEB BASE URL ---
# During local development: http://localhost:3000
# In production (e.g., Vercel): https://celron.vercel.app or your custom domain
NEXT_PUBLIC_BASE_URL=http://localhost:3000
EXPO_PUBLIC_BASE_URL=http://localhost:3000

# Company WhatsApp Business Number for Cel-Ron Enterprises Pte Ltd
NEXT_PUBLIC_COMPANY_WHATSAPP=+6581962270

# ==============================================================================
# SUPABASE EDGE FUNCTION SECRETS
# Set these in your Supabase Dashboard: Settings -> Edge Functions -> Secrets
# or via Supabase CLI: supabase secrets set KEY=VALUE
# ==============================================================================
# 1. Google Gemini Flash (Used by 'extract-card' AI business card scanner)
#    Get key from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# 2. Meta WhatsApp Cloud API (Used by 'whatsapp-webhook' for visitor diary)
#    From Meta Developer Portal -> WhatsApp -> API Setup
WA_PHONE_NUMBER_ID=your_meta_phone_number_id
WA_ACCESS_TOKEN=your_permanent_system_user_token
WA_APP_SECRET=your_meta_app_secret
WA_VERIFY_TOKEN=your_custom_webhook_secret_token
WHATSAPP_ENABLED=false
